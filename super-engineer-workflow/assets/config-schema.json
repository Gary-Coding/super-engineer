{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "super-engineer workspace.yml",
  "type": "object",
  "required": ["version", "mode", "todo_file", "reference_files", "code_path", "output_dir"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": ["manual", "auto"]
    },
    "todo_file": {
      "type": "string",
      "minLength": 1
    },
    "reference_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "code_path": {
      "type": "string",
      "minLength": 1
    },
    "output_dir": {
      "type": "string",
      "minLength": 1
    }
  }
}
